{
  "name": "spec-project",
  "version": "1.0.0",
  "private": true,
  "description": "Spec-Driven Development demo: 手机号验证码登录 (001-phone-sms-login)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @spec/frontend",
    "storybook:test": "npm run storybook:test --workspace @spec/frontend",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev -w @spec/backend\" \"npm run dev -w @spec/frontend\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsx-a11y": "npm:eslint-plugin-jsx-a11y@^6.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
