# ===== 环境变量示例（提交到仓库，实值放 .env 并加入 gitignore） =====

# --- 服务端口 ---
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# --- Redis（验证码 / 限流 / 令牌吊销列表）---
REDIS_URL=redis://localhost:6379

# --- 短信通道（测试环境白名单固定验证码 135792）---
SMS_PROVIDER_KEY=test-provider-key
SMS_TEST_WHITELIST=13800000000,13800000001,13800000002,13800000003
SMS_TEST_FIXED_CODE=135792

# --- RSA（前端加密密码用；生产私钥绝不可提交）---
RSA_PRIVATE_KEY_PEM=file://./keys/private.pem
RSA_KID=rsa-20260901

# --- JWT ---
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_TTL=7d

# --- 安全策略阈值（对齐 spec FR-003/FR-008/FR-009）---
SMS_COOLDOWN_SECONDS=60
SMS_CODE_TTL_SECONDS=300
SMS_MAX_VERIFY_ERRORS=5
SMS_LOCK_MINUTES=10
PASSWORD_MAX_ERRORS=10
ACCOUNT_LOCK_MINUTES=30
IP_RATE_LIMIT_PER_MINUTE=20
PHONE_RATE_LIMIT_PER_HOUR=10
